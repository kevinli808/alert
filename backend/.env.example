# Copy to .env and fill in. NEVER commit .env. Nothing in this file belongs in the React app.

ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth0 (Dashboard → Applications → APIs) ---------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.deaf-accessibility.app
AUTH0_CLAIM_NAMESPACE=https://deaf-accessibility.app

# --- Supabase (Dashboard → Project Settings → API Keys) --------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role (legacy JWT) or sb_secret_... key. Server-side only — bypasses RLS.
SUPABASE_SERVICE_KEY=

# --- Audio limits ----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=2000000
MIN_AUDIO_SECONDS=0.5
MAX_AUDIO_SECONDS=10
SILENCE_RMS_THRESHOLD=0.003

# --- Inference ---------------------------------------------------------------------------------
INFERENCE_PROVIDER=local           # local | databricks
YAMNET_MODEL_HANDLE=https://tfhub.dev/google/yamnet/1
SCORE_AGGREGATION=max              # max | mean (over YAMNet's 0.48 s frames)
PRELOAD_MODEL=true

# --- Prediction processing --------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.75          # experimental starting point — calibrate with scripts/evaluate_model.py
CATEGORY_THRESHOLDS=               # optional JSON, e.g. {"glass_breaking":0.5,"smoke_detector":0.6}
DETECTION_COOLDOWN_SECONDS=10
RECORD_HISTORY=true

# --- Databricks Model Serving (optional; placeholder until you deploy a model) ---------------
DATABRICKS_HOST=                   # e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN=                  # PAT or service-principal OAuth token
DATABRICKS_ENDPOINT_NAME=          # e.g. yamnet-sound-alerts
DATABRICKS_TIMEOUT_SECONDS=5
DATABRICKS_FALLBACK_TO_LOCAL=true

# --- Rate limits (per user, per minute) --------------------------------------------------------
RATE_LIMIT_DETECT_PER_MINUTE=120
RATE_LIMIT_DEFAULT_PER_MINUTE=60
