# Frontend settings template. Copy this file to `.env.local` (git-ignored) and restart `npx next dev`:
#   PowerShell:  copy .env.example .env.local
#
# Everything here is a PUBLIC identifier (it ends up in the browser anyway). Never put secrets in
# NEXT_PUBLIC_* variables; backend secrets belong in backend/.env.

# Backend URL. Set this for local dev; when unset, requests go to the same origin (Vercel rewrites).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth0 login (the "Alert Web" single-page app). AUDIENCE must equal the backend's AUTH0_AUDIENCE.
# Leave any of these empty to use the local preview login instead.
NEXT_PUBLIC_AUTH0_DOMAIN=dev-t05xsx0lnbde0242.us.auth0.com
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.deaf-accessibility.app
NEXT_PUBLIC_AUTH0_CLIENT_ID=80kVz2ZpF8p9xLSO0av2wUQrgHc8YHm6
